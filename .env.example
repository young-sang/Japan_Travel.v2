# 공개 서버용 설정 (D-086). 서버에서 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다(.gitignore).
# 로컬 시연은 .env 없이도 기본값으로 뜬다.
#
# 값을 만드는 명령 (서버에서):
#   openssl rand -hex 16                    → DB_PASSWORD
#   openssl rand -hex 32                    → JWT_SECRET (32바이트 이상)
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" '새-admin-비밀번호' | tr -d ':\n'   → ADMIN_PASSWORD_HASH
#
# ADMIN_PASSWORD_HASH 는 $ 가 들어 있어 반드시 작은따옴표로 감싼다.
# DB_PASSWORD 는 db 볼륨을 처음 만들 때만 적용된다. 바꾸려면 docker compose down -v 로 볼륨을 지우고 다시 올린다.

DB_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD_HASH=''
WEB_PORT=80
